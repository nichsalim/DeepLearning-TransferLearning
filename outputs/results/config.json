{
  "config": {
    "seed": 42,
    "num_classes": 10,
    "n_cat_classes": 5,
    "n_dog_classes": 5,
    "split_train_val_test": [
      0.7,
      0.15,
      0.15
    ],
    "resize": 256,
    "img_size": 224,
    "imagenet_mean": [
      0.485,
      0.456,
      0.406
    ],
    "imagenet_std": [
      0.229,
      0.224,
      0.225
    ],
    "batch_size": 32,
    "optimizer": "AdamW",
    "loss": "CrossEntropyLoss",
    "weight_decay": 0.01,
    "lr_scratch": 0.001,
    "lr_head": 0.001,
    "lr_backbone_ft": 0.0001,
    "max_epochs": 40,
    "patience": 5,
    "min_delta": 0.0,
    "early_stopping_monitor": "val_loss",
    "checkpoint_rule": "epoch dengan val_loss terendah (bobot dipulihkan sebelum evaluasi test)",
    "best_condition_rule": "val_acc tertinggi pada checkpoint; seri -> val_loss terendah",
    "eval_train_clean": true,
    "num_workers": 2,
    "amp": false,
    "cache_images": true,
    "run_b5": true,
    "run_c5": true,
    "resume": true
  },
  "env": {
    "python": "3.13.15",
    "platform": "Linux-6.6.122+-x86_64-with-glibc2.39",
    "torch": "2.11.0+cu130",
    "torchvision": "0.26.0+cu130",
    "numpy": "2.1.3",
    "pandas": "2.2.3",
    "scikit_learn": "1.6.1",
    "matplotlib": "3.10.0",
    "pillow": "11.3.0",
    "device": "cuda",
    "gpu_name": "Tesla T4",
    "cuda_version": "13.0",
    "cudnn_version": 92700,
    "in_colab": true,
    "smoke_test": false
  }
}